PORT=3001
CLIENT_ORIGIN=https://electric-football.netlify.app/
TICK_RATE=20

# [dev reveal] Set to 1 to draw the computer's own call over the field in a solo game, so a bad
# alignment can be screenshotted next to what it should have been. Dev builds + solo rooms only.
ENABLE_DEV_REVEAL=0

# [dev flags] Set to 1 to drop the delay-of-game penalty: the play clock still runs out, it just
# costs nothing. For working on alignment without the down being replayed every 25 seconds.
DISABLE_DELAY_OF_GAME=0
